			</element>
			<element kind="textField" uuid="a1b2c3d4-0003-4003-8003-000000000016" key="netPayInWords" x="134" y="60" width="300" height="28" fontSize="9.0" italic="true">
				<expression><![CDATA[$F{netPayInWords}]]></expression>
			</element>
			<element kind="rectangle" uuid="a1b2c3d4-0003-4003-8003-000000000017" key="amountBox" x="440" y="58" width="113" height="24">
