			</element>
			<element kind="textField" uuid="a1b2c3d4-0003-4003-8003-000000000033" key="deductionLabels" x="300" y="310" width="200" height="60" fontSize="7.0">
				<expression><![CDATA["PAYE\nPRSI\nUSC" + ($F{lpt} != null ? "\nLPT" : "") + ($F{deductionsText} != null && !$F{deductionsText}.isEmpty() ? "\n" + $F{deductionsText} : "")]]></expression>
			</element>
			<element kind="textField" uuid="a1b2c3d4-0003-4003-8003-000000000034" key="paye" x="500" y="310" width="53" height="12" fontSize="7.0" hTextAlign="Right" pattern="#,##0.00">
