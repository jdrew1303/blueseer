<?xml version="1.0" encoding="UTF-8"?>
<!-- Created for the Irish Payroll module (com.blueseer.pay). Matches Thesaurus
     Payroll Manager 2026's documented "Payslip & Cheque" stationery type
     (thesaurus.ie/docs/2026/distributing-payslips/printing-payslips/):
     "prints a cheque at the top of the page and the payslip at the bottom" -
     one employee per page (the detail band is sized close to the full page,
     so JasperReports naturally places one record per sheet without needing
     an explicit page-break group). Same field set as the 2-per-page
     templates, plus netPayInWords for the cheque's amount-in-words line.

     JasperReports 7.x JRXML syntax (see payslip_2perpage_hires.jrxml's header
     comment for the 6.x -> 7.x rationale). -->
<jasperReport name="payslip_and_cheque" pageWidth="595" pageHeight="842" columnWidth="567" leftMargin="14" rightMargin="14" topMargin="20" bottomMargin="20" uuid="a1b2c3d4-0003-4003-8003-000000000001">
	<field name="employerName" class="java.lang.String"/>
	<field name="employerAddress" class="java.lang.String"/>
	<field name="employerRegistrationNumber" class="java.lang.String"/>
	<field name="employeeName" class="java.lang.String"/>
	<field name="employeeAddress" class="java.lang.String"/>
	<field name="ppsNumber" class="java.lang.String"/>
	<field name="worksNumber" class="java.lang.String"/>
	<field name="payDate" class="java.time.LocalDate"/>
	<field name="periodNumber" class="java.lang.Integer"/>
	<field name="taxYear" class="java.lang.Integer"/>
	<field name="payFrequency" class="java.lang.String"/>
	<field name="prsiClass" class="java.lang.String"/>
	<field name="calculationBasis" class="java.lang.String"/>
	<field name="grossPay" class="java.math.BigDecimal"/>
	<field name="additionsText" class="java.lang.String"/>
	<field name="deductionsText" class="java.lang.String"/>
	<field name="paye" class="java.math.BigDecimal"/>
	<field name="employeePrsi" class="java.math.BigDecimal"/>
	<field name="usc" class="java.math.BigDecimal"/>
	<field name="lpt" class="java.math.BigDecimal"/>
	<field name="netPay" class="java.math.BigDecimal"/>
	<field name="employerPrsi" class="java.math.BigDecimal"/>
	<field name="annualTaxCredit" class="java.math.BigDecimal"/>
	<field name="annualCutOffPoint" class="java.math.BigDecimal"/>
	<field name="cumulativeGrossPay" class="java.math.BigDecimal"/>
	<field name="cumulativeTaxPaid" class="java.math.BigDecimal"/>
	<field name="cumulativePrsiPaid" class="java.math.BigDecimal"/>
	<field name="cumulativeUscPaid" class="java.math.BigDecimal"/>
	<field name="netPayInWords" class="java.lang.String"/>
	<detail>
		<band height="780" splitType="Stretch">
			<!-- Cheque area -->
			<element kind="rectangle" uuid="a1b2c3d4-0003-4003-8003-000000000010" key="chequeFrame" x="0" y="0" width="567" height="150">
				<pen lineWidth="0.75" lineColor="#000000"/>
			</element>
			<element kind="textField" uuid="a1b2c3d4-0003-4003-8003-000000000011" key="chequeEmployerName" x="14" y="8" width="320" height="16" fontSize="11.0" bold="true">
				<expression><![CDATA[$F{employerName}]]></expression>
			</element>
			<element kind="textField" uuid="a1b2c3d4-0003-4003-8003-000000000012" key="chequeDate" x="420" y="8" width="133" height="16" fontSize="10.0" hTextAlign="Right" pattern="dd/MM/yyyy">
				<expression><![CDATA["Date: " + $F{payDate}]]></expression>
			</element>
			<element kind="staticText" uuid="a1b2c3d4-0003-4003-8003-000000000013" key="payToLabel" x="14" y="40" width="80" height="14" fontSize="9.0">
				<text><![CDATA[Pay to:]]></text>
			</element>
			<element kind="textField" uuid="a1b2c3d4-0003-4003-8003-000000000014" key="payee" x="94" y="40" width="459" height="14" fontSize="10.0" bold="true" underline="true">
				<expression><![CDATA[$F{employeeName}]]></expression>
			</element>
			<element kind="staticText" uuid="a1b2c3d4-0003-4003-8003-000000000015" key="sumOfLabel" x="14" y="60" width="120" height="14" fontSize="9.0">
