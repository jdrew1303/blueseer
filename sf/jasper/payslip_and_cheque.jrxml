			</element>
			<element kind="textField" uuid="a1b2c3d4-0003-4003-8003-000000000018" key="amountFigures" x="440" y="58" width="113" height="24" fontSize="12.0" bold="true" hTextAlign="Center" vTextAlign="Middle" pattern="&#8364;#,##0.00">
