			<element kind="textField" uuid="a1b2c3d4-0003-4003-8003-00000000002c" key="payDatePeriod" x="300" y="271" width="253" height="12" fontSize="8.0" pattern="dd/MM/yyyy">
				<expression><![CDATA["Pay Date: " + $F{payDate} + "   Period: " + $F{periodNumber} + " (" + $F{payFrequency} + ")"]]></expression>
