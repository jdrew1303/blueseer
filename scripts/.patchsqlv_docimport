/* sql updates for agentic document import (com.blueseer.doc) - see
   docs/epics/agentic-document-import.md for the full epic.

   NOTE: named descriptively rather than the next numeric version, same
   convention as .patchsqlv_ingredientlabeling - the SQL itself is plain
   additive CREATE TABLE IF NOT EXISTS plus idempotent seed logic, so it's
   safe to run regardless of where it lands in the client's actual
   .patchsqlvNN sequence.
*/

select '*** ALTER SCHEMA SECTION (single-shot - not safely re-runnable, matching .patchsqlv_ingredientmaterialtype convention) ***';
select '';

/* One-time setup, never shown to end users - see epic Sec 7.3. Provider is
   free text (not a DB-enforced enum) so a future runtime option doesn't
   need a schema change; DocumentExtractionService is the only code that
   interprets the value. ov_llm_baseurl defaults to LM Studio's own default
   local endpoint. */
alter table ov_ctrl add column ov_llm_provider varchar(20) NOT NULL DEFAULT 'LMSTUDIO';
alter table ov_ctrl add column ov_llm_baseurl varchar(200) NOT NULL DEFAULT 'http://localhost:1234';
alter table ov_ctrl add column ov_llm_model varchar(100) NOT NULL DEFAULT '';
alter table ov_ctrl add column ov_llm_enabled tinyint(1) NOT NULL DEFAULT '0';

select '*** ADD TABLE IF NOT EXISTS SECTION ***';
select '';

/* Traceability record only (epic Sec 7.1 step 7) - not a workflow screen
   staff interact with. log_doctype is free text (e.g. 'INVOICE',
   'INGREDIENT_SPEC') matching the extraction schema used; log_target_key
   is whatever key ties this import back to what it populated (a receiver
   id for the invoice case, an item code for the ingredient-spec case). */
CREATE TABLE IF NOT EXISTS `doc_import_log` (
  `log_id` varchar(10) NOT NULL PRIMARY KEY,
  `log_doctype` varchar(30) NOT NULL DEFAULT '',
  `log_target_key` varchar(40) NOT NULL DEFAULT '',
  `log_extracted_json` text,
  `log_userid` varchar(30) NOT NULL DEFAULT '',
  `log_created` datetime DEFAULT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

/* Supplier item-description memory (epic Sec 7, DOC-21/DOC-12) - once a
   user maps a supplier's raw invoice line text to a real item_mstr row,
   remember it here so the same supplier's future invoices auto-fill that
   line without asking again. Keyed by (vendor, raw text) since the same
   wording can mean different things from different suppliers. alias_vend
   matches recv_mstr.rv_vend / vd_mstr.vd_addr's varchar(10) sizing. */
CREATE TABLE IF NOT EXISTS `doc_item_alias` (
  `alias_vend` varchar(10) NOT NULL,
  `alias_rawtext` varchar(200) NOT NULL,
  `alias_item` varchar(100) NOT NULL DEFAULT '',
  PRIMARY KEY (`alias_vend`, `alias_rawtext`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

select '*** UPDATE RECORDS SECTION ***';
select '';
/* none */

select '*** INSERT RECORDS SECTION ***';
select '';
/* none for ov_ctrl - it's a singleton row already created by the base
   install; the ALTER TABLE defaults above populate it for existing
   installs.

   Scan to Import Settings menu item (com.blueseer.doc.
   DocImportSettingsPanel) - a standalone Admin screen rather than a new
   SystemControl tab, to avoid hand-editing SystemControl's generated
   GroupLayout. Same menu_mstr/menu_tree/perm_mstr shape as every other
   menu-driven screen (copied from the SystemControl row); mt_index 28
   is the next free slot under Admin (see menu_tree where mt_par='Admin'
   at patch-authoring time - re-check before applying if the client's
   Admin menu has grown since).

   Labeled "Scan to Import" rather than "Document Import" throughout the
   UI (menu_id/class names are unchanged, just the visible text) - the
   client felt "Document Import" reads too close to the existing
   "Master Data Import" bulk-CSV-load screen for non-technical staff. */
insert into menu_mstr (menu_id, menu_desc, menu_panel, menu_type, menu_navcode)
select 'DocImportSettings', 'Scan to Import Settings',
       'com.blueseer.doc.DocImportSettingsPanel', 'JMenuItem', 'docimport'
where not exists (select 1 from menu_mstr where menu_id = 'DocImportSettings');

insert into menu_tree (mt_par, mt_child, mt_index, mt_type, mt_label, mt_icon, mt_initvar, mt_func, mt_visible, mt_enable)
select 'Admin', 'DocImportSettings', 28, 'JMenuItem', 'Scan to Import Settings', '', '1', '', 1, 1
where not exists (select 1 from menu_tree where mt_par = 'Admin' and mt_child = 'DocImportSettings');

insert into perm_mstr (perm_user, perm_menu, perm_readonly)
select user_id, 'DocImportSettings', 0 from user_mstr
where not exists (select 1 from perm_mstr where perm_user = user_mstr.user_id and perm_menu = 'DocImportSettings');

/* Scan to Import - the actual staff-facing screen (com.blueseer.doc.
   ScanToImportPanel), one central entry point rather than buried under an
   unrelated domain menu (Purchasing, Inventory, etc.) or scattered across
   every screen that might receive paper (see the epic and
   ScanToImportPanel's class javadoc).

   IMPORTANT: BlueSeer's top-level menu bar is NOT purely data-driven - it's
   a fixed, hardcoded list in MainFrame.getmenuheaders() (edi, address,
   purchasing, ..., help, custom), each resolved through
   BlueSeerUtils.getGlobalMenuTag(key) against the bs*.properties language
   files. A brand new top-level menu_id (e.g. 'Scan') would never render,
   no matter what's inserted here - MainFrame.getMenus() only ever looks
   for menu_tree rows under the exact label text getGlobalMenuTag returns
   for one of those fixed keys. The last of those, "custom" -> "Custom"
   (global.menu.custom in bs.properties), is exactly this project's
   designed-in extension slot for a client-specific top-level menu with no
   Java changes, so this hangs Scan to Import off that instead of inventing
   a new one. mt_index values below are cosmetic bookkeeping only - actual
   top-bar position is fixed by that hardcoded array, not by mt_index. */
insert into menu_mstr (menu_id, menu_desc, menu_panel, menu_type, menu_navcode)
select 'Custom', '', '', 'JMenu', ''
where not exists (select 1 from menu_mstr where menu_id = 'Custom');

insert into menu_tree (mt_par, mt_child, mt_index, mt_type, mt_label, mt_icon, mt_initvar, mt_func, mt_visible, mt_enable)
select 'root', 'Custom', 14, 'JMenu', 'Custom', '', '1', '', 1, 1
where not exists (select 1 from menu_tree where mt_par = 'root' and mt_child = 'Custom');

insert into menu_mstr (menu_id, menu_desc, menu_panel, menu_type, menu_navcode)
select 'ScanToImport', 'Scan to Import', 'com.blueseer.doc.ScanToImportPanel', 'JMenuItem', 'scantoimport'
where not exists (select 1 from menu_mstr where menu_id = 'ScanToImport');

insert into menu_tree (mt_par, mt_child, mt_index, mt_type, mt_label, mt_icon, mt_initvar, mt_func, mt_visible, mt_enable)
select 'Custom', 'ScanToImport', 1, 'JMenuItem', 'Scan to Import', '', '1', '', 1, 1
where not exists (select 1 from menu_tree where mt_par = 'Custom' and mt_child = 'ScanToImport');

insert into perm_mstr (perm_user, perm_menu, perm_readonly)
select user_id, 'Custom', 0 from user_mstr
where not exists (select 1 from perm_mstr where perm_user = user_mstr.user_id and perm_menu = 'Custom');

insert into perm_mstr (perm_user, perm_menu, perm_readonly)
select user_id, 'ScanToImport', 0 from user_mstr
where not exists (select 1 from perm_mstr where perm_user = user_mstr.user_id and perm_menu = 'ScanToImport');

select '';
select concat("sql schema version is : ", ov_version) from ov_ctrl;
select '*** SQL UPDATE ENDS ***';
