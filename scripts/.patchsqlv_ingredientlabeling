/* sql updates for the EU/Irish FIC ingredient-labeling feature (com.blueseer.ing)

   NOTE: named descriptively rather than the next numeric version (the last
   patch checked into this repo is v70, but the running app is well past
   that - this repo doesn't have the client's live patch sequence). Rename/
   renumber this to fit the client's actual .patchsqlvNN sequence at deploy
   time; the SQL itself is plain additive CREATE TABLE IF NOT EXISTS plus
   idempotent seed inserts, so it's safe to run regardless of where it lands
   in the sequence.
*/

select '*** ALTER SCHEMA SECTION ***';
select '';

/* no changes to existing tables - this feature is entirely new tables */

select '*** ADD TABLE IF NOT EXISTS SECTION ***';
select '';

/* ing_wt_per_uom_g: grams equivalent to 1 unit of this item's own it_uom.
   Default 1 assumes it_uom is already gram-comparable with the rest of the
   recipe. Set explicitly for a volume-tracked ingredient (e.g. water in mL
   is ~1, oil in mL is ~0.92) so liquids and solids sort/sum correctly. */
CREATE TABLE IF NOT EXISTS `ing_mstr` (
  `it_item` varchar(36) NOT NULL PRIMARY KEY,
  `ing_legalname` varchar(200) NOT NULL DEFAULT '',
  `ing_category` varchar(60) NOT NULL DEFAULT '',
  `ing_enumber` varchar(10) NOT NULL DEFAULT '',
  `ing_iscompound` tinyint(1) NOT NULL DEFAULT '0',
  `ing_active` tinyint(1) NOT NULL DEFAULT '1',
  `ing_notes` varchar(500) NOT NULL DEFAULT '',
  `ing_wt_per_uom_g` decimal(12,5) NOT NULL DEFAULT '1'
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

CREATE TABLE IF NOT EXISTS `ing_allergen_ref` (
  `allergen_code` varchar(20) NOT NULL PRIMARY KEY,
  `allergen_desc` varchar(100) NOT NULL DEFAULT ''
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

CREATE TABLE IF NOT EXISTS `ing_allergen` (
  `it_item` varchar(36) NOT NULL,
  `allergen_code` varchar(20) NOT NULL,
  PRIMARY KEY (`it_item`, `allergen_code`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

CREATE TABLE IF NOT EXISTS `ing_subingredient` (
  `it_item` varchar(36) NOT NULL,
  `seq` int(4) NOT NULL,
  `sub_name` varchar(200) NOT NULL DEFAULT '',
  `sub_enumber` varchar(10) NOT NULL DEFAULT '',
  `is_allergen` tinyint(1) NOT NULL DEFAULT '0',
  PRIMARY KEY (`it_item`, `seq`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

CREATE TABLE IF NOT EXISTS `warn_rule` (
  `warn_code` varchar(30) NOT NULL PRIMARY KEY,
  `trigger_type` varchar(20) NOT NULL DEFAULT '',
  `trigger_value` varchar(60) NOT NULL DEFAULT '',
  `threshold_pct` decimal(8,4) NOT NULL DEFAULT '0',
  `warning_text` varchar(300) NOT NULL DEFAULT '',
  `warn_active` tinyint(1) NOT NULL DEFAULT '1'
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

/* QUID (Quantitative Ingredient Declaration, FIC Annex VIII/FSAI guidance):
   it_item is the FINISHED item being labeled, quid_item is the ingredient
   item code (anywhere in that finished item's flattened BOM) whose
   percentage must be stated - because it's named in the product name,
   emphasized on the pack, or characterizes the product. This is a property
   of the (finished item, ingredient) pair, not of the ingredient alone -
   the same raw material may need QUID on one product's label and not
   another's. */
CREATE TABLE IF NOT EXISTS `ing_quid` (
  `it_item` varchar(36) NOT NULL,
  `quid_item` varchar(36) NOT NULL,
  `quid_active` tinyint(1) NOT NULL DEFAULT '1',
  PRIMARY KEY (`it_item`, `quid_item`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

/* Reconstituted/dehydrated ingredients (FSAI guidance: QUID must use the
   weight AFTER rehydration, not the dry/concentrated weight). it_item is
   the FINISHED item being labeled, recon_item is a diluent's item code
   within that item's own flattened BOM (e.g. water), target_item is the
   item code its weight should fold into instead of appearing as its own
   ingredient-list entry (e.g. milk powder). Scoped per finished item, not
   a global property of the diluent - the same water item code might
   reconstitute milk powder in one recipe and just be plain water in
   another, exactly like ing_quid above. */
CREATE TABLE IF NOT EXISTS `ing_recon` (
  `it_item` varchar(36) NOT NULL,
  `recon_item` varchar(36) NOT NULL,
  `target_item` varchar(36) NOT NULL,
  PRIMARY KEY (`it_item`, `recon_item`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

select '*** ALTER TABLE SECTION (single-shot - not safely re-runnable, matching scripts/sqliteupgrade.txt's convention for plain column adds) ***';
select '';

/* it_moistloss: this FINISHED item's production process (cooking/baking/
   drying) loses moisture, so QUID for its ingredients must be calculated
   against this item's finished weight (item_mstr.it_net_wt) rather than
   the pre-loss mixing-bowl total - see IngredientLabelEngine's QUID javadoc. */
alter table item_mstr add column it_moistloss tinyint(1) NOT NULL DEFAULT '0';

select '*** UPDATE RECORDS SECTION ***';
select '';
