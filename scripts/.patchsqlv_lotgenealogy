/* Registers the lot genealogy / recall lookup (com.blueseer.trc.
   LotGenealogyPanel) as a real menu item, following the exact same
   menu_mstr/menu_tree/perm_mstr shape as every other menu-driven screen
   (copied from the existing NutritionCompletenessRpt row) - not a new
   mechanism, just data.

   Placed under the "Quality" top-level menu, alongside the nutrition
   completeness report - a mock-recall/genealogy lookup is exactly the same
   category of compliance/quality-assurance tool.

   Plain additive inserts, each guarded by NOT EXISTS, safe to re-run and
   safe regardless of where it lands in the client's actual .patchsqlvNN
   sequence - same convention as .patchsqlv_nutritioncompletenessreport.

   NOTE: perm_mstr is a flat (perm_user, perm_menu) grant table, not a role
   table - the insert below grants every user that already exists at
   patch-install time. Any user created afterwards needs the same grant
   added the normal way - this patch cannot anticipate future users.
*/

insert into menu_mstr (menu_id, menu_desc, menu_panel, menu_type, menu_navcode)
select 'LotGenealogyRpt', 'Lot Genealogy / Recall Lookup',
       'com.blueseer.trc.LotGenealogyPanel', 'JMenuItem', 'lotgen'
where not exists (select 1 from menu_mstr where menu_id = 'LotGenealogyRpt');

insert into menu_tree (mt_par, mt_child, mt_index, mt_type, mt_label, mt_icon, mt_initvar, mt_func, mt_visible, mt_enable)
select 'Quality', 'LotGenealogyRpt', 4, 'JMenuItem', 'Lot Genealogy / Recall Lookup', '', '1', '', 1, 1
where not exists (select 1 from menu_tree where mt_par = 'Quality' and mt_child = 'LotGenealogyRpt');

insert into perm_mstr (perm_user, perm_menu, perm_readonly)
select user_id, 'LotGenealogyRpt', 0 from user_mstr
where not exists (select 1 from perm_mstr where perm_user = user_mstr.user_id and perm_menu = 'LotGenealogyRpt');
